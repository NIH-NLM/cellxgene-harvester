/*
 * cellxgene-harvester Nextflow configuration
 */

params {
    // Required
    tissue   = null
    organism = "Homo sapiens"
    outdir   = "results"

    // Filtering options
    min_age         = 15
    no_preprints    = true
    exclude_cancer  = true
    exclude_spatial = true

    // Container
    container = "ghcr.io/nih-nlm/cellxgene-harvester:1.0.0"
}

// Default process settings
process {
    container = params.container

    withLabel: 'small' {
        cpus   = 1
        memory = '4 GB'
        time   = '30 min'
    }

    withLabel: 'medium' {
        cpus   = 2
        memory = '16 GB'
        time   = '2 h'
    }

    withLabel: 'large' {
        cpus   = 4
        memory = '32 GB'
        time   = '4 h'
    }
}

profiles {

    // Local development (no container)
    local {
        process.executor = 'local'
        conda.enabled    = true
        process.conda    = "${projectDir}/environment.yml"
        docker.enabled   = false
    }

    // Docker (default for testing)
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
        conda.enabled          = false
    }

    // Singularity (for HPC / Lifebit)
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        conda.enabled          = false
    }

    // Lifebit CloudOS
    lifebit {
        process.executor       = 'k8s'
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        conda.enabled          = false

        process {
            withLabel: 'small' {
                cpus   = 2
                memory = '8 GB'
            }
            withLabel: 'medium' {
                cpus   = 4
                memory = '32 GB'
            }
            withLabel: 'large' {
                cpus   = 8
                memory = '64 GB'
            }
        }
    }

    // CI/CD regression testing (fast, small)
    test {
        params.tissue   = "kidney"
        params.organism = "Homo sapiens"
        params.outdir   = "test_results"
        params.min_age  = 15

        process {
            withLabel: 'small'  { memory = '2 GB' }
            withLabel: 'medium' { memory = '8 GB' }
            withLabel: 'large'  { memory = '16 GB' }
        }
    }
}

// Capture Nextflow log
timeline {
    enabled = true
    file    = "${params.outdir}/logs/timeline.html"
}

report {
    enabled = true
    file    = "${params.outdir}/logs/report.html"
}

trace {
    enabled = true
    file    = "${params.outdir}/logs/trace.txt"
}
